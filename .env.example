# ==============================================================================
# SaveBite Root Environment Configuration (Template)
# Copy this to .env or configure client/.env and server/.env separately
# ==============================================================================

# Backend Port
PORT=5000
NODE_ENV=development

# Frontend Base URL (for CORS)
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL Connection URL (from Supabase Project Settings -> Database)
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"

# Supabase Storage & API Keys (from Supabase Project Settings -> API)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="savebite-assets"

# Razorpay Sandbox Credentials (for Phase 4)
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourKeySecret"
