# ==============================================================================
# SaveBite Client Environment Configuration (Vite + React)
# Copy this file to client/.env and replace with your actual Firebase project values
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Firebase Client SDK Configuration (From Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="savebite-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="savebite-app"
VITE_FIREBASE_STORAGE_BUCKET="savebite-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Razorpay Key ID for Client SDK (Sandbox Test Mode)
VITE_RAZORPAY_KEY_ID="rzp_test_placeholderKey"
