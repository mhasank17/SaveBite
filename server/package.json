{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "SaveBite Node.js + Express + TypeScript Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node -r ts-node/register --test --test-concurrency=1 tests/auth.test.ts tests/order.test.ts tests/partner.test.ts tests/verification.test.ts tests/admin.test.ts tests/address.test.ts",
    "test:auth": "node -r ts-node/register --test tests/auth.test.ts",
    "test:order": "node -r ts-node/register --test tests/order.test.ts",
    "test:partner": "node -r ts-node/register --test tests/partner.test.ts",
    "test:verify": "node -r ts-node/register --test tests/verification.test.ts",
    "test:admin": "node -r ts-node/register --test tests/admin.test.ts",
    "test:address": "node -r ts-node/register --test tests/address.test.ts",
    "test:smtp": "node -r ts-node/register src/scripts/testSmtp.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node -r ts-node/register prisma/seed.ts"
  },
  "prisma": {
    "seed": "node -r ts-node/register prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/nodemailer": "^8.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.20.0",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "nodemailer": "^10.2.1",
    "razorpay": "^2.9.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.19.1",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vitest": "^5.0.5"
  }
}
